# Copy these values into C:\Users\wei\Desktop\iot\.env or set them in the shell.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# This laptop's verified external USB webcam index is 1; use 0 only for the built-in camera.
MODULE4_CAMERA_INDEX=1
MODULE4_CAPTURE_INTERVAL_SECONDS=300

# MQTT values normally do not need to change.
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883
MQTT_BASE=smartfarm/rsd2s3g3
